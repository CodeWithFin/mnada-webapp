# Server
PORT=5000
NODE_ENV=development

# Database (Supabase only – see SUPABASE_SETUP.md). Use Session pooler URI (port 5432).
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Frontend URL (for CORS and Paystack redirect; monolithic prod: same origin, e.g. http://localhost:5000)
FRONTEND_URL=http://localhost:5173

# Supabase (Storage for images): Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Paystack (checkout)
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Email (OTP / passwordless)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
